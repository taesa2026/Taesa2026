
create table if not exists public.vehicles (
  id uuid primary key default gen_random_uuid(),
  plate text not null unique,
  model text not null,
  year integer not null check (year between 1980 and 2100),
  mileage numeric not null default 0 check (mileage >= 0),
  status text not null default 'DisponÃ­vel' check (status in ('DisponÃ­vel', 'Em Rota', 'ManutenÃ§Ã£o')),
  created_at timestamptz not null default now()
);

create table if not exists public.maintenances (
  id uuid primary key default gen_random_uuid(),
  vehicle_id uuid not null references public.vehicles(id) on delete cascade,
  date date not null,
  description text not null,
  cost numeric(12,2) not null default 0 check (cost >= 0),
  created_at timestamptz not null default now()
);

create table if not exists public.trips (
  id uuid primary key default gen_random_uuid(),
  vehicle_id uuid not null references public.vehicles(id) on delete cascade,
  vehicle_plate text not null,
  date date not null default current_date,
  departure_at timestamptz not null default now(),
  km_initial numeric not null check (km_initial >= 0),
  km_final numeric check (km_final is null or km_final >= km_initial),
  photo_before_url text,
  photo_after_url text,
  fuel_liters numeric(10,2) check (fuel_liters is null or fuel_liters >= 0),
  driver_name text not null default 'Motorista',
  notes text,
  created_at timestamptz not null default now()
);

create index if not exists maintenances_vehicle_id_idx on public.maintenances(vehicle_id);
create index if not exists trips_vehicle_id_idx on public.trips(vehicle_id);
create index if not exists trips_date_idx on public.trips(date desc);

alter table public.vehicles enable row level security;
alter table public.maintenances enable row level security;
alter table public.trips enable row level security;

